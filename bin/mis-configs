#!/usr/bin/env bash
# mis-configs: helper for this setup.
#   mis-configs update   pull the latest config and re-run the installer
#   mis-configs doctor   show installed versions and common problems
#   mis-configs import   copy changes made directly in ~/.tmux or ~/.vim into the repo
#   mis-configs backup   save this machine's current configs to ~/mis-configs-old
#   mis-configs status   what changed in the repo and is not pushed yet
#   mis-configs edit     open the repo in Neovim
set -euo pipefail
DOTFILES="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

case "${1:-help}" in
  update)
    git -C "$DOTFILES" pull --ff-only
    "$DOTFILES/install.sh" --yes
    ;;
  doctor)
    # shellcheck source=../versions.env
    source "$DOTFILES/versions.env"
    check() { # name expected-version command...
      local name=$1 want=$2 got; shift 2
      if command -v "$name" >/dev/null; then
        got=$("$@" 2>/dev/null | grep -oE 'v?[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1)
        printf '  %-12s %-10s (repo: %s)\n' "$name" "$got" "$want"
      else
        printf '  %-12s MISSING (repo: %s)\n' "$name" "$want"
      fi
    }
    echo "Tools"
    check nvim "$NVIM_VERSION" nvim --version
    check tmux "3.2+" tmux -V
    check tree-sitter "$TREE_SITTER_VERSION" tree-sitter --version
    check fzf "$FZF_VERSION" fzf --version
    check rg "apt" rg --version
    check fd "apt" fd --version
    check zoxide "$ZOXIDE_VERSION" zoxide --version
    check eza "$EZA_VERSION" eza --version
    check starship "$STARSHIP_VERSION" starship --version
    check lazygit "$LAZYGIT_VERSION" lazygit --version
    check delta "$DELTA_VERSION" delta --version
    check node "v$NODE_MAJOR" node --version
    check claude "optional" claude --version
    echo "Checks"
    [[ "$(readlink -f "$HOME/.config/nvim")" == "$DOTFILES/nvim" ]] && echo "  nvim config linked" || echo "  nvim config NOT linked (run install.sh)"
    [[ "$(readlink -f "$HOME/.tmux.conf")" == "$DOTFILES/tmux/tmux.conf" ]] && echo "  tmux config linked" || echo "  tmux config NOT linked (run install.sh)"
    [[ "$(readlink -f "$HOME/.vimrc")" == "$DOTFILES/vim/vimrc" ]] && echo "  vim config linked" || echo "  vim config NOT linked (run install.sh)"
    [[ "$DOTFILES" == /mnt/* ]] && echo "  WARNING: repo is on the Windows disk; move it into WSL (~/dev/mis-configs)"
    git -C "$DOTFILES" fetch -q 2>/dev/null && [[ -n "$(git -C "$DOTFILES" log 'HEAD..@{u}' --oneline 2>/dev/null)" ]] && echo "  Updates available: dotfiles update"
    echo "Neovim health: run :checkhealth inside nvim"
    ;;
  import) "$DOTFILES/scripts/import-current.sh" && git -C "$DOTFILES" status --short ;;
  backup) "$DOTFILES/scripts/backup-old.sh" ;;
  status)
    git -C "$DOTFILES" status --short
    git -C "$DOTFILES" log --oneline '@{u}..HEAD' 2>/dev/null | sed 's/^/  not pushed: /'
    ;;
  edit) cd "$DOTFILES" && exec nvim . ;;
  *) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
