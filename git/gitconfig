# Git extras, included from ~/.gitconfig by install.sh. Only display and convenience settings:
# nothing here changes how pull, merge or commit behave. Name and email stay in ~/.gitconfig.
[init]
	defaultBranch = main
[fetch]
	prune = true
[push]
	autoSetupRemote = true
[diff]
	colorMoved = default
	algorithm = histogram
[merge]
	conflictStyle = diff3
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[alias]
	st = status -sb
	lg = log --oneline --graph --decorate -20
	undo = reset --soft HEAD~1
